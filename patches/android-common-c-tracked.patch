+
+// Only the keepalive thread sends: JNI never blocks on ENet, and the first
+// full keyframe guarantee prevents hidden startup from timing out on video.
+static bool sendPendingBackgroundState(void) {
+    uint8_t payload[4];
+    if (!BscPrepare(&backgroundControl, payload)) {
+        return true;
+    }
+    if (!sendMessageAndForget(0x3003, sizeof(payload), payload,
+                              CTRL_CHANNEL_SERVERCTL, ENET_PACKET_FLAG_RELIABLE, false)) {
+        return false;
+    }
+    BscCommit(&backgroundControl, payload);
+    return true;
+}
