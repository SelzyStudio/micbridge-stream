 void destroyMicrophoneStream(void) {
+    // Connection.c joins the control thread before closing this socket.
+    MkaWithdrawReady(&micKeepalive);
     if (micSocket != INVALID_SOCKET) {
         closeSocket(micSocket);
         micSocket = INVALID_SOCKET;
@@ -62,6 +70,25 @@ void destroyMicrophoneStream(void) {
     micTimestamp = 0;
 }
 
+void pollMicrophoneKeepalive(uint64_t nowMs) {
+    uint8_t payload[MIC_KEEPALIVE_BYTES];
+    if (!MkaPrepare(&micKeepalive, nowMs,
+                    StreamConfig.enableMic && MicPortNumber != 0,
+                    (EncryptionFeaturesEnabled & SS_ENC_MICROPHONE) != 0,
+                    IS_SUNSHINE() && (SunshineFeatureFlags & LI_FF_BACKGROUND_STREAM_CONTROL),
+                    ConnectionInterrupted, payload)) {
+        return;
+    }
+    LC_SOCKADDR destination;
+    memcpy(&destination, &RemoteAddr, sizeof(destination));
+    SET_PORT(&destination, MicPortNumber);
+    // Use the media socket itself so NAT keeps this exact UDP binding alive.
+    // The host ignores four-byte datagrams before parsing any microphone data.
+    // Like audio/video pings, a transient heartbeat send error is nonfatal.
+    sendto(micSocket, (const char*)payload, sizeof(payload), 0,
+           (struct sockaddr*)&destination, AddrLen);
+}
