+int LiSetStreamBackground(bool background) {
+    if (stopping || peer == NULL || client == NULL) {
+        return -1;
+    }
+    if (!IS_SUNSHINE() || !encryptedControlStream ||
+        !(SunshineFeatureFlags & LI_FF_BACKGROUND_STREAM_CONTROL)) {
+        return -2;
+    }
+    BscRequest(&backgroundControl, background);
+    return 0;
