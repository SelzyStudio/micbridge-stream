+    /** Release held keys and callbacks while retaining the layout and visibility preference. */
+    public void releaseSessionInput() {
+        if (destroyed) return;
+        releasingInput = true;
+        handler.removeCallbacksAndMessages(null);
+        keyEventRunnableMap.clear();
+        if (activeDialog != null) {
+            activeDialog.dismiss();
+            activeDialog = null;
+        }
+        long now = SystemClock.uptimeMillis();
+        MotionEvent cancel = MotionEvent.obtain(now, now, MotionEvent.ACTION_CANCEL, 0, 0, 0);
+        try {
+            for (keyBoardVirtualControllerElement element : elements) {
+                if (element instanceof KeyBoardDigitalButton) {
+                    ((KeyBoardDigitalButton) element).releaseHeldInput();
+                } else {
+                    element.onElementTouchEvent(cancel);
+                }
+                element.cancelPendingInputEvents();
+                element.setPressed(false);
+            }
+        } finally {
+            cancel.recycle();
+            releasingInput = false;
+        }
+        // CANCEL on a touchpad may schedule a click's long-press callback.
+        handler.removeCallbacksAndMessages(null);
+    }
