+    private boolean startApp(NvHTTP h) throws XmlPullParserException, IOException {
+        checkStartCancelled();
+        String serverInfo = resumeOnlyPcUuid == null ? h.getServerInfo(true) : h.getServerInfoStrict();
+        checkStartCancelled();
+        
+        context.serverAppVersion = h.getServerVersion(serverInfo);
+        if (context.serverAppVersion == null) {
+            context.connListener.displayMessage("Server version malformed");
+            return false;
+        }
+
+        ComputerDetails details = h.getComputerDetails(serverInfo);
+        if (resumeOnlyPcUuid != null && (details.uuid == null || !resumeOnlyPcUuid.equalsIgnoreCase(details.uuid))) {
+            throw new HostHttpResponseException(401, "Original host identity changed");
+        }
