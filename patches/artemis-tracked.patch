+    private void registerReconnectNetworkMonitor() {
+        ConnectivityManager manager = (ConnectivityManager) getSystemService(CONNECTIVITY_SERVICE);
+        if (manager == null) return;
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+                reconnectDefaultNetwork = manager.getActiveNetwork();
+                reconnectController.setNetworkAvailable(reconnectDefaultNetwork != null);
+                reconnectNetworkCallback = new ConnectivityManager.NetworkCallback() {
+                    @Override public void onAvailable(Network network) {
+                        timerHandler.post(() -> {
+                            if (sessionClosing) return;
+                            Network previous = reconnectDefaultNetwork;
+                            reconnectDefaultNetwork = network;
+                            reconnectController.setNetworkAvailable(true);
+                            if (previous != null && !previous.equals(network) &&
+                                    shouldReactToNetworkChange()) {
+                                requestAutomaticReconnect(true);
+                            }
+                        });
+                    }
+                    @Override public void onLost(Network network) {
+                        timerHandler.post(() -> {
+                            if (sessionClosing || !network.equals(reconnectDefaultNetwork)) return;
+                            reconnectDefaultNetwork = null;
+                            reconnectController.setNetworkAvailable(false);
+                            if (shouldReactToNetworkChange()) requestAutomaticReconnect(true);
+                        });
+                    }
+                };
+                manager.registerDefaultNetworkCallback(reconnectNetworkCallback);
+            } else {
+                reconnectLegacyReceiver = new BroadcastReceiver() {
+                    @Override public void onReceive(Context context, Intent intent) {
+                        final boolean initial = isInitialStickyBroadcast();
+                        timerHandler.post(() -> {
+                            if (sessionClosing) return;
+                            NetworkInfo network = manager.getActiveNetworkInfo();
+                            boolean available = network != null && network.isConnected();
+                            reconnectController.setNetworkAvailable(available);
+                            if (!initial && shouldReactToNetworkChange()) {
+                                requestAutomaticReconnect(true);
+                            }
+                        });
+                    }
+                };
+                registerReceiver(reconnectLegacyReceiver, new IntentFilter(ConnectivityManager.CONNECTIVITY_ACTION));
+            }
+        } catch (RuntimeException failure) {
+            LimeLog.warning("Network change observer unavailable: " + failure.getClass().getSimpleName());
+            // Native socket errors still trigger recovery if a device rejects observer registration.
+        }
+    }
+
+    private boolean shouldReactToNetworkChange() {
+        return connected || (activeReconnectAttempt != 0 && connecting) ||
+                (reconnectController != null && reconnectController.isRecovering() &&
+                        reconnectController.getAttemptCount() == 0);
+    }
+
+    private void unregisterReconnectNetworkMonitor() {
+        if (reconnectNetworkCallback != null) {
+            try { ((ConnectivityManager) getSystemService(CONNECTIVITY_SERVICE))
+                    .unregisterNetworkCallback(reconnectNetworkCallback); } catch (RuntimeException ignored) { }
+            reconnectNetworkCallback = null;
+        }
+        if (reconnectLegacyReceiver != null) {
+            try { unregisterReceiver(reconnectLegacyReceiver); } catch (RuntimeException ignored) { }
+            reconnectLegacyReceiver = null;
+        }
+    }
