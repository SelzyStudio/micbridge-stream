+    /** Release only keyboard keys sent by this connection, preserving key flags. */
+    public void releasePressedKeys() {
+        // A pending handshake has not sent keys and owns the lifetime monitor;
+        // Activity pause must not wait for it just to clear an empty key set.
+        if (isMonkey || stopRequested || !bridgeReady || !ownsBridge()) {
+            synchronized (pressedKeys) {
+                pressedKeys.clear();
+            }
+            return;
+        }
+        synchronized (MoonBridge.class) {
+            synchronized (pressedKeys) {
+                if (!stopRequested && bridgeReady && ownsBridge()) {
+                    for (int keyId : pressedKeys) {
+                        MoonBridge.sendKeyboardInput((short) (keyId >>> 8), KeyboardPacket.KEY_UP,
+                                (byte) 0, (byte) keyId);
+                    }
+                }
+                pressedKeys.clear();
+            }
+        }
+    }
