+    boolean startApp() throws XmlPullParserException, IOException {
+        checkStartCancelled();
+        NvHTTP h = createStartHttp();
+        synchronized (httpStartLock) {
+            checkStartCancelled();
+            activeStartHttp = h;
+        }
+        try {
+            boolean result = startApp(h);
+            checkStartCancelled();
+            return result;
+        } finally {
+            synchronized (httpStartLock) {
+                if (activeStartHttp == h) activeStartHttp = null;
+            }
+        }
+    }
