+    private void requestAutomaticReconnect(boolean networkChange) {
+        if (sessionClosing || !autoReconnectArmed || timerHandler == null) return;
+        final long generation = connectionGeneration;
+        timerHandler.post(() -> {
+            if (ownsConnection(generation) && reconnectController != null) {
+                retryCurrentTransport(true, networkChange);
+            } else if (networkChange && !sessionClosing && reconnectController != null &&
+                    connectionGeneration == generation + 1 && activeReconnectAttempt == 0 &&
+                    reconnectController.isRecovering() && reconnectController.getAttemptCount() == 0) {
