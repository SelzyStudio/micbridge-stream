+    protected void resolveReconnectTarget(long generation) {
+        if (sessionClosing || !activityStarted || microphoneExecutor.isShutdown()) {
+            if (reconnectController != null) reconnectController.attemptFailed(generation);
+            return;
+        }
+        showReconnectStatus();
+        microphoneExecutor.execute(() -> {
+            if (sessionClosing) return;
+            ReconnectHostResolver resolver = new ReconnectHostResolver(getApplicationContext(),
+                    getIntent().getStringExtra(EXTRA_PC_UUID), serverCert, uniqueId,
+                    new ComputerDetails.AddressTuple(host, port), httpsPort);
+            reconnectResolver = resolver;
+            try {
+                ReconnectHostResolver.Result target = resolver.resolve();
+                // The capability is accepted only from the original paired PC's pinned HTTPS
+                // serverinfo. Legacy hosts still wait out their old microphone ownership lease.
+                if (!microphoneHandoffGate.awaitReady(() -> !sessionClosing && activityStarted,
+                        target.supportsFastMicHandoff)) {
+                    timerHandler.post(() -> {
+                        if (!sessionClosing) reconnectController.attemptFailed(generation);
+                    });
+                    return;
+                }
+                timerHandler.post(() -> completeReconnectResolution(generation, target));
+            } catch (ReconnectHostResolver.TerminalException failure) {
+                timerHandler.post(() -> {
+                    if (!sessionClosing && reconnectController.isCurrentAttempt(generation)) {
+                        stopConnection();
+                        if (activityStarted) {
+                            Dialog.displayDialog(Game.this, getString(R.string.conn_error_title),
+                                    getString(R.string.stream_reconnect_failed) + " (" + failure.errorCode + ")", true);
+                        } else {
+                            finish();
+                        }
+                    }
+                });
+            } catch (java.io.IOException | InterruptedException failure) {
+                timerHandler.post(() -> {
+                    if (!sessionClosing) reconnectController.attemptFailed(generation);
+                });
+            } finally {
+                if (reconnectResolver == resolver) reconnectResolver = null;
+            }
+        });
+    }
+
+    private void completeReconnectResolution(long generation, ReconnectHostResolver.Result target) {
+        if (sessionClosing || !reconnectController.isCurrentAttempt(generation)) return;
+        if (!activityStarted || isFinishing()) {
+            reconnectController.attemptFailed(generation);
+            return;
+        }
+        // The old native transport has stopped on the serial worker. Keep the Activity,
+        // Surface, UI, pan/zoom and foreground-service identity, replacing only one-shot bindings.
+        installReconnectTransport(generation, target);
+    }
