+    /** Lost-transport recovery only. Normal user disconnects retain reliable ENet linger. */
+    public void stopForReconnect() {
+        stop(true);
+    }
+
+    private void stop(boolean forReconnect) {
+        if (forReconnect) reconnectStopRequested = true;
+        stopRequested = true;
+        synchronized (httpStartLock) {
+            if (activeStartHttp != null) activeStartHttp.cancelPendingRequests();
+        }
+        // Interrupt must remain outside MoonBridge.class: startConnection holds
+        // that lock while connecting. Ownership cannot change during the check.
+        synchronized (bridgeOwnershipLock) {
+            if (ownsBridge()) {
+                if (reconnectStopRequested) MoonBridge.interruptConnectionForReconnect();
+                else MoonBridge.interruptConnection();
+            } else {
+                // Stale/HTTP-only owners have no native lifetime to wait for.
+                releaseConnectionPermit();
+                return;
+            }
+        }
+        synchronized (MoonBridge.class) {
+            if (ownsBridge()) {
+                bridgeReady = false;
+                if (reconnectStopRequested) MoonBridge.stopConnectionForReconnect();
+                else MoonBridge.stopConnection();
+                MoonBridge.cleanupBridge();
+                synchronized (bridgeOwnershipLock) {
+                    bridgeOwner = null;
+                }
+            }
+        }
+        releaseConnectionPermit();
+    }
+
+    private boolean ownsBridge() {
+        return bridgeOwner == this && ownedBridgeGeneration == bridgeGeneration;
+    }
+
+    private void releaseConnectionPermit() {
+        if (connectionPermitHeld.compareAndSet(true, false)) {
+            connectionAllowed.release();
+        }
+    }
