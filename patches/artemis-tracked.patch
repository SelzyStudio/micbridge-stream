+    /** One-shot retry policy: reconnect may resume this PC/app, never replace another session. */
+    public void setResumeOnly(String expectedPcUuid) {
+        if (expectedPcUuid == null || expectedPcUuid.isEmpty()) {
+            throw new IllegalArgumentException("Expected PC UUID required");
+        }
+        resumeOnlyPcUuid = expectedPcUuid;
+    }
