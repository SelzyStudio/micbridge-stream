+        buttonAddKeys.cancelPendingInputEvents();
+        buttonConfigure.setOnClickListener(null);
+        buttonConfigure.setOnLongClickListener(null);
+        buttonConfigure.setOnTouchListener(null);
+        buttonClearAll.setOnClickListener(null);
+        buttonAddKeys.setOnClickListener(null);
+        removeElements();
+    }
