+                int keyId = ((keyMap & 0xffff) << 8) | (flags & 0xff);
+                if (keyDirection == KeyboardPacket.KEY_DOWN) {
+                    pressedKeys.add(keyId);
+                } else if (keyDirection == KeyboardPacket.KEY_UP) {
+                    pressedKeys.remove(keyId);
+                }
+            }
+        }
