+    /** Enqueues stop before any resolver work, while a bounded PixelCopy finishes on the UI thread. */
+    private void suspendLostTransport(boolean fastTransportStop) {
+        final NvConnection lostConnection = conn;
+        final ResumableVideoDecoderRenderer lostVideo = sessionVideoRenderer;
+        final CountDownLatch captureComplete = new CountDownLatch(1);
+        if (lostConnection != null && !microphoneExecutor.isShutdown()) {
+            microphoneExecutor.execute(() -> {
+                try { captureComplete.await(300, TimeUnit.MILLISECONDS); }
+                catch (InterruptedException interrupted) { Thread.currentThread().interrupt(); }
+                if (fastTransportStop) lostConnection.stopForReconnect();
+                else lostConnection.stop();
+                microphoneHandoffGate.transportStopped(prefConfig != null && prefConfig.enableMicrophone);
+            });
+        }
+        Runnable suspend = () -> {
+            try {
+                if (lostVideo != null) lostVideo.setForeground(false);
+            } catch (RuntimeException failure) {
+                LimeLog.warning("Unable to suspend lost decoder: " + failure.getClass().getSimpleName());
+            } finally { captureComplete.countDown(); }
+        };
+        if (continuityOverlay != null && streamContainer != null) {
+            continuityOverlay.captureAndHold(streamContainer.getSurfaceView(), suspend);
+        } else {
+            suspend.run();
+        }
+    }
