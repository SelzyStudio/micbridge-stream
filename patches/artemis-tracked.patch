-        if(prefConfig.enableJoyConFix&&context.vendorId == 0x057e && context.productId == 0x2007){
-            switch (event.getScanCode())
-            {
-                case 307://XY相反
-                    return KeyEvent.KEYCODE_BUTTON_Y;
-                case 308:
-                    return KeyEvent.KEYCODE_BUTTON_X;
-                case 304:
-                    return KeyEvent.KEYCODE_BUTTON_A;
