+            long decMs = (System.nanoTime() - enqNs) / 1_000_000L;
+            if (decMs >= 0 && decMs < 1000) {
+                activeWindowVideoStats.decoderTimeMs += decMs;
+                if (!USE_FRAME_RENDER_TIME) {
+                    activeWindowVideoStats.totalTimeMs += decMs;
+                }
+            }
+        }
+    }
