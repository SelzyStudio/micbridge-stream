+    private void retryCurrentTransport(boolean fastTransportStop, boolean networkChange) {
+        if (sessionClosing || reconnectController == null) return;
+        if (activeReconnectAttempt != 0) {
+            long attempt = activeReconnectAttempt;
+            activeReconnectAttempt = 0;
+            enterTransportRecovery(fastTransportStop);
+            reconnectController.attemptFailed(attempt);
