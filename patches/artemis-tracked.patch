+                throw new HostHttpResponseException(410, "Original application session has ended");
+            }
+            boolean uuidAvailable = app.getAppUUID() != null && !app.getAppUUID().isEmpty() &&
+                    runningUuid != null && !runningUuid.isEmpty();
