+        if (keyBoardController != null) keyBoardController.destroyForReconnect();
+        if (virtualController != null) virtualController.destroyForReconnect();
+        connected = connecting = transportStarted = freshFramePresented = false;
+        attemptedConnection = true;
+        awaitingFreshFrame = true;
+        recoveringTransport = true;
+        if (continuityOverlay != null) continuityOverlay.markAwaitingFreshFrame();
+        updatePipAutoEnter();
+        if (spinner != null) { spinner.dismiss(); spinner = null; }
+        if (sessionAudioRenderer != null) sessionAudioRenderer.setSuspended(true);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        setPerformanceWifiLocks(false);
+        timerHandler.removeCallbacks(backgroundPing);
