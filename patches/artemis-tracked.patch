+    /**
+     * Queue background video/audio state without doing network I/O on this
+     * caller. 0=accepted/pending, -2=unsupported host, -1=stopped/stale owner.
+     * A request made before connection readiness is applied after start.
+     */
+    public int setStreamBackground(boolean background) {
+        requestedBackground = background;
+        if (stopRequested || isMonkey || (bridgeClaimed && !ownsBridge())) {
+            return -1;
+        }
+        // startConnection holds the native lifetime lock for the entire
+        // handshake. The volatile request is enough until readiness; never
+        // make the Activity wait for that lock while it is connecting.
+        if (!bridgeReady) {
+            return 0;
+        }
+        synchronized (MoonBridge.class) {
+            if (stopRequested || (bridgeClaimed && !ownsBridge())) {
+                return -1;
+            }
+            if (!bridgeReady) {
+                return 0;
+            }
+            return MoonBridge.setStreamBackground(background);
+        }
+    }
